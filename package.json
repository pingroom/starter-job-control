{
  "name": "pingroom-starter-job-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Pause, resume, or cancel remaining local batch work through trusted PingRoom actions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js tick",
